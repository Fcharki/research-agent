# Backend (FastAPI)
# Host of the Ollama server used by the agent (the `ollama` Python client
# reads OLLAMA_HOST from the environment).
OLLAMA_HOST=http://localhost:11434

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Path to the SQLite database file used for history and sources.
DB_PATH=research.db

# Frontend (Next.js)
# Public base URL of the backend API, as seen by the browser.
# NOTE: NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
